#!/bin/tcsh
#SBATCH -N 2
#SBATCH -t 1:00:00
#SBATCH -p pdebug

setenv OMP_NUM_THREADS 1
#setenv KMP_DETERMINISTIC_REDUCTION 1

setenv LD_LIBRARY_PATH ${maindir}/build_quartz/libROM/build/lib:$LD_LIBRARY_PATH

set maindir = /p/lustre2/cheung26/mgmol
set exe     = ${maindir}/install_quartz/bin/mgmol-opt
set datadir = $maindir/examples/H2O_64
set cfg_quench = mgmol_quench.cfg
set cfg_md = mgmol_md.cfg

#set ncpus = 98
#set ncpus = 49
set ncpus = 64

source $maindir/scripts/modules.quartz

srun -n $ncpus $exe -c $cfg_quench -i coords.in > quench_H2O_64.out
srun -n $ncpus $exe -c $cfg_md -i coords.in > md_H2O_64.out
